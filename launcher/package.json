{
  "name": "@enw-zombies/launcher",
  "version": "0.2.23",
  "private": true,
  "type": "module",
  "description": "ENW Zombies launcher",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "detect": "node src/main/detect-cli.js",
    "setup": "node src/main/setup-cli.js",
    "test": "node test/run-all.js && node test/waw-settings.js && node test/modcompat.js && node test/discord-presence.js",
    "test:launch": "node test/launch-harness.js",
    "play": "node src/main/play-cli.js",
    "maps": "node src/main/maps-cli.js",
    "slice": "node test/slice.js",
    "pack": "node tools/stage-client.js && electron-builder --win --publish never && node tools/publish-update.js",
    "stage-client": "node tools/stage-client.js",
    "prepack": "node tools/stage-client.js",
    "publish-update": "node tools/publish-update.js",
    "smoke": "node tools/smoke.js",
    "test:chain": "node test/local-chain.js",
    "last-run": "node tools/last-run.js"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "author": {
    "name": "ENW"
  },
  "build": {
    "appId": "gg.enw.zombies.launcher",
    "productName": "ENW Zombies",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "tools/**/*",
      "resources/manifests/**/*",
      "!resources/client/**",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "tools/**"
    ],
    "protocols": [
      {
        "name": "ENW Zombies",
        "schemes": [
          "enw-zombies"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/renderer/assets/icon-256.png"
    },
    "compression": "maximum",
    "asar": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://zombies.enw.gg/updates"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "ENW-Zombies-Launcher-Setup-${version}.exe",
      "shortcutName": "ENW Zombies"
    },
    "extraResources": [
      {
        "from": "resources/client",
        "to": "client"
      },
      {
        "from": "../referee/manifests",
        "to": "host-agent/manifests"
      },
      {
        "from": "../infra/host-agent",
        "to": "host-agent",
        "filter": [
          "**/*",
          "!node_modules",
          "!test/**",
          "!tools/soak.js",
          "!**/*.py",
          "!measurement.json"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
