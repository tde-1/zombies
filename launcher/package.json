{
  "name": "@enw-zombies/launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ENW Zombies launcher",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "detect": "node src/main/detect-cli.js",
    "setup": "node src/main/setup-cli.js",
    "test": "node test/run-all.js",
    "test:launch": "node test/launch-harness.js",
    "play": "node src/main/play-cli.js",
    "maps": "node src/main/maps-cli.js",
    "slice": "node test/slice.js",
    "pack": "node tools/stage-client.js && electron-builder --win --publish never",
    "stage-client": "node tools/stage-client.js",
    "prepack": "node tools/stage-client.js"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "author": {
    "name": "ENW"
  },
  "build": {
    "appId": "gg.enw.zombies.launcher",
    "productName": "ENW Zombies",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "tools/**/*",
      "resources/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/renderer/assets/icon-256.png"
    },
    "compression": "maximum",
    "asar": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://zombies.enw.gg/updates"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "ENW-Zombies-Launcher-Setup-${version}.exe",
      "shortcutName": "ENW Zombies"
    },
    "extraResources": [
      {
        "from": "resources/client",
        "to": "client"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
