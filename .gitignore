# build output
build/
out/
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe
# never commit game files or dumps
*.ff
*.iwd
dumps/
# python (tools/re, referee/)
__pycache__/
*.pyc

# node
node_modules/
infra/host-agent/data/
# local
*.log
.vs/
# Third-party CHECKOUTS belong in ZombiesDev\thirdparty, not here (dev-box.md
# rule 9), so this folder is ignored by default...
thirdparty/*
# ...but code we VENDOR under its licence must be committed, or the repo will
# not build on a fresh clone. MinHook is BSD-2-Clause; LICENSE.txt, AUTHORS.txt
# and VENDORED-FROM.txt (the upstream commit) are kept next to the sources.
!thirdparty/minhook/
ZombiesDev/
.dev-keys/

# packaged launcher builds (85 MB per build; rebuild with `npm run pack`)
launcher/dist/
# staged client DLL for packaging (a build artefact; `npm run pack` re-stages it)
launcher/resources/client/
infra/keepalive.log

# The launcher update feed is a BUILD ARTEFACT, produced by `cd launcher && npm run pack`
# (tools/publish-update.js). The installer itself is already ignored by *.exe above, and
# committing latest.yml without it would publish a feed pointing at a file that is not
# there — which electron-updater reports as a corrupt download.
web/public/updates/latest.yml
web/public/updates/*.blockmap

# Secrets live in infra/site.env, which keepalive.ps1 loads into the site's environment.
# There is no dotenv in the server on purpose -- nothing reads a file from the repo root
# by accident. infra/site.env.example is the committed template.
.env
*.env
!infra/site.env.example
!infra/discord.env.example

# Hetzner Cloud API token for the Zombies dev box (B supplies it; never commit)
infra/hcloud.env

# Map art copied out of the archive by web/server/db/import-archive.js. Derived;
# `npm run import:archive` puts it back.
web/public/media/

# Object-storage keys (docs/kickstart/storage.md). infra/s3.env.example is the template.
infra/s3.env
