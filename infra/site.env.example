# The live site's environment. Copy to infra\site.env and fill in.
#
#   copy infra\site.env.example infra\site.env
#
# infra\site.env is gitignored and MUST stay that way -- this repo is public.
# keepalive.ps1 loads it before starting the site, so a change takes effect the next
# time the site cycles. There is deliberately no dotenv in the server: nothing should
# pick up a file from the repo root by accident.

# ---- the closed beta front door ----------------------------------------------------
# One shared password in front of the whole site. Everyone types the same one; who you
# ARE is still decided by sign-in. Unset it and the site is open to the internet.
ZM_SITE_PASSWORD=CrazyTime

# ---- where the site lives ------------------------------------------------------------
# Used to build Steam's return URL and realm. Must be the public origin, not localhost,
# or Steam will refuse the login.
ZM_PUBLIC_URL=https://zombies.enw.gg

# ---- sign-in -------------------------------------------------------------------------
# `steam` is a request, not a switch: the server falls back to the mock page unless
# STEAM_API_KEY and ZM_PUBLIC_URL are both set (routes/auth.js effectiveMode()). So it
# is safe to leave this as `steam` while the key is blank -- the day a key is pasted in
# below, real sign-in turns on by itself on the next cycle.
ZM_AUTH=steam

# ---- Discord Rich Presence -----------------------------------------------------------
# The "ENW Zombies" application id from https://discord.com/developers/applications
# (General Information -> Application ID). Every launcher reads it from
# /api/launcher/hello at startup; blank = presence stays off. Public, not a secret.
ZM_DISCORD_CLIENT_ID=

# A Steam Web API key from https://steamcommunity.com/dev/apikey
#
# READ THIS BEFORE REGISTERING ONE. **Steam issues one Web API key per account.**
# Registering a key on that page replaces any key that account already has. If the same
# Steam account is behind ENW Movement's sign-in, registering here silently breaks
# Movement's login, and the breakage shows up as "sign-in stopped working" with nothing
# in the logs pointing at this. Check Movement's production environment for an existing
# key first, and reuse it rather than registering a new one.
#
# The key is read-only -- it validates OpenID logins and reads public profile data. It
# grants nothing on any game server. So sharing one between Movement and Zombies does
# not join the two systems in the way B's "separate zones, servers and systems" rule is
# about; it is a fact of how Steam issues keys, not a design choice available to us.
STEAM_API_KEY=

# ---- the ENW link (names and VIP) ------------------------------------------------------
# Both stubbed. Nothing leaves this machine while these are unset: names fall back to the
# Steam persona and VIP to the cached value.
ZM_ENW_BASE=
ZM_ENW_TOKEN=

# ---- the replay viewer (docs/kickstart/replay.md) ---------------------------------------
# Exported map geometry: one <bsp>/<bsp>.glb and <bsp>/<bsp>.meta.json per map, built by
# tools/maps/export_map.py. Mounted read-only at /mapdata. It is GAME-DERIVED and is never
# committed, so it lives outside the repo and the site mounts it rather than copying it.
# Unset, the site uses %ZOMBIES_DEV%\maps, i.e. C:\Users\b\ZombiesDev\maps. The mount is
# decided at boot: export a map the site has never seen and it needs one restart.
ZM_MAPS_DIR=

# Where signed .enwr replays are read from. Unset, C:\Users\b\ZombiesDev\replays.
ZM_REPLAY_DIR=

# A box posts a POINTER to its replay, never the bytes, and the Hetzner box's filesystem
# is not this one -- so a real game's replay is not here to decode. When the file is
# missing, the site scp's it once from the box and caches it in ZM_REPLAY_DIR. The ssh
# host is the box's own name (`zombies-dev`, which is already a Host in ~/.ssh/config);
# ZM_REPLAY_PULL_HOSTS is a JSON map for anything else, e.g. {"box-b":"other-alias"}.
# Set ZM_REPLAY_PULL=off to turn it off; the viewer then 404s for games recorded elsewhere.
ZM_REPLAY_PULL=
ZM_REPLAY_PULL_HOST=
ZM_REPLAY_PULL_HOSTS=

# ---- object storage (docs/kickstart/storage.md) -----------------------------------------
# When set, /updates/<installer|blockmap>, /api/maps/<bsp>/files/<file> and /mapdata/*.glb
# answer 302 to the public bucket copy when the bucket holds a same-size one (checked with
# an anonymous HEAD, cached 5 min); otherwise they are served from this PC as before.
# Names only -- the site never holds the S3 keys (those are infra\s3.env, for the uploader).
# Leave blank to serve everything locally.
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_BUCKET_FILES=
S3_BUCKET_MAPS=

# ---- telemetry (docs/kickstart/telemetry.md) --------------------------------------------
# All optional; these are the defaults. 2026-09-23: the site now WRITES log bundles to the
# bucket (logs/...), and for that it reads the S3 keys from infra\s3.env itself (not from
# this file), so the "names only" line above is about the download redirects only.
# ZM_TELEMETRY_MAX_MB=200          # one bundle
# ZM_TELEMETRY_PER_DAY=40          # bundles per player per 24 h
# ZM_TELEMETRY_GB_PER_DAY=2        # bytes per player per 24 h
# ZM_TELEMETRY_UPLOAD=on           # off: keep bundles on this PC only
# ZM_TELEMETRY_BUCKET=             # default: S3_BUCKET_FILES
# ZM_TELEMETRY_KEEP_LOCAL=0        # 1: keep the local copy after the bucket has it
