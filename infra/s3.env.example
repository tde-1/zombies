# Hetzner Object Storage keys for tools/s3/sync.js, tools/s3/check.js and
# launcher/tools/publish-update.js (docs/kickstart/storage.md). Copy to infra\s3.env:
#
#   copy infra\s3.env.example infra\s3.env
#
# infra\s3.env is gitignored and MUST stay that way -- this repo is public. The live
# site never reads it: the buckets are public, so the site only needs their NAMES
# (S3_BUCKET_FILES / S3_BUCKET_MAPS in infra\site.env) to redirect downloads there.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional; these are the defaults.
# S3_ENDPOINT=https://nbg1.your-objectstorage.com
# S3_BUCKET_FILES=enw-zombies-files
# S3_BUCKET_MAPS=enw-zombies-maps
