# infra/discord.env -- the Discord values for the site. Copy this file to infra/discord.env
# (gitignored) and fill it in. The site reads it every time node starts
# (web/server/lib/discordEnv.js), so a normal site restart picks up a change: no launcher
# release, no keepalive-loop restart. A value in infra/site.env wins (leave it blank there).
# Only ZM_DISCORD_CLIENT_ID (and ENW_DISCORD_INVITE below) are loaded; the other keys are kept
# here for later and never reach the server's environment.

# ---- REQUIRED for Rich Presence ("Playing ENW Zombies" on Discord profiles) ---------------
# The Application ID of the "ENW Zombies" app: https://discord.com/developers/applications
# -> your app -> General Information -> APPLICATION ID (a 17-20 digit number). Public, not a
# secret. Every launcher gets it from /api/launcher/hello at its next start; blank = off.
ZM_DISCORD_CLIENT_ID=

# ---- Kept for later: NOT read by any code today ----------------------------------------------
# General Information -> PUBLIC KEY (64 hex). Would verify Discord interaction webhooks.
ZM_DISCORD_PUBLIC_KEY=
# Bot -> TOKEN. A SECRET: never commit it, never paste it anywhere else.
ZM_DISCORD_BOT_TOKEN=

# ---- Optional ---------------------------------------------------------------------------------
# The Discord invite link in the site's top right. Default https://discord.enw.gg.
# ENW_DISCORD_INVITE=https://discord.enw.gg
